# Copy this file to .env and fill it in. NEVER commit .env.

# Long random string. Must match the secret in your TradingView alert message.
WEBHOOK_SECRET=

# Alpaca API keys (https://alpaca.markets). Use PAPER keys to start.
ALPACA_API_KEY=
ALPACA_API_SECRET=

# false = paper trading (fake money). Only set true after testing on paper.
LIVE_TRADING=false

# Comma-separated list of tickers the bot may trade. Empty = any.
ALLOWED_SYMBOLS=AAPL,SPY

# Safety limits
MAX_QTY_PER_ORDER=10
MAX_POSITION_VALUE=1000
MAX_TRADES_PER_DAY=10
MAX_DAILY_LOSS=100

# Set to false (or create a file named STOP next to the bot) to block new buys.
TRADING_ENABLED=true
KILL_SWITCH_FILE=STOP

PORT=8000

# --- Self-running trader (python -m bot.autotrader), no TradingView needed ---
TRADE_QTY=1
FAST_EMA=9
SLOW_EMA=21
CHECK_INTERVAL_SECONDS=60
FLATTEN_MINUTES_BEFORE_CLOSE=10
